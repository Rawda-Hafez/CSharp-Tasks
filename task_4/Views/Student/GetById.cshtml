@model ASS_2.Models.Student

@{
    ViewData["Title"] = "Student Details - GetById";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Student Profile (GetById)</h4>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm">Delete</a>
            </div>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">Student ID</dt>
                <dd class="col-sm-9 fw-bold">@Model.Id</dd>

                <dt class="col-sm-3 text-muted">Full Name</dt>
                <dd class="col-sm-9 fs-5">@Model.Name</dd>

                <dt class="col-sm-3 text-muted">Age</dt>
                <dd class="col-sm-9">@Model.Age</dd>

                <dt class="col-sm-3 text-muted">Department</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-info text-dark">
                        @(Model.Department?.Name ?? "No Department Assigned")
                    </span>
                </dd>

                <dt class="col-sm-3 text-muted">Department Manager</dt>
                <dd class="col-sm-9">@(Model.Department?.MgrName ?? "N/A")</dd>
            </dl>

            @if (Model.StuCrsRes != null && Model.StuCrsRes.Any())
            {
                <hr />
                <h5 class="mt-3">Enrolled Courses & Grades</h5>
                <ul class="list-group list-group-flush mt-2">
                    @foreach (var crs in Model.StuCrsRes)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@(crs.Course?.Name ?? "Course")</span>
                            <span class="badge bg-success rounded-pill">Grade: @crs.Grade</span>
                        </li>
                    }
                </ul>
            }
        </div>
        <div class="card-footer bg-light">
            <a asp-action="GetAll" class="btn btn-secondary">
                &larr; Back to Students List
            </a>
        </div>
    </div>
</div>
