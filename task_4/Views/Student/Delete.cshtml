@model ASS_2.Models.Student

@{
    ViewData["Title"] = "Delete Confirmation - Warning";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-4 me-2"></i>
                    <h4 class="mb-0">Delete Warning Confirmation</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning d-flex align-items-center" role="alert">
                        <div>
                            <strong>Warning!</strong> Are you sure you want to permanently delete this student? This action cannot be undone.
                        </div>
                    </div>

                    <div class="card bg-light border-0 mb-3">
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4 text-muted">Student ID</dt>
                                <dd class="col-sm-8 fw-bold">@Model.Id</dd>

                                <dt class="col-sm-4 text-muted">Full Name</dt>
                                <dd class="col-sm-8 fs-5 text-dark">@Model.Name</dd>

                                <dt class="col-sm-4 text-muted">Age</dt>
                                <dd class="col-sm-8">@Model.Age</dd>

                                <dt class="col-sm-4 text-muted">Department</dt>
                                <dd class="col-sm-8">@(Model.Department?.Name ?? "N/A")</dd>
                            </dl>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a asp-action="GetAll" class="btn btn-secondary">
                                &larr; No, Cancel
                            </a>
                            <button type="submit" class="btn btn-danger">
                                Yes, Delete Permanently
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
