@model StudentListViewModel

@{
    ViewData["Title"] = "Students List - GetAll";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Students Management</h2>
        <a asp-action="Add" class="btn btn-success">
            <i class="bi bi-person-plus"></i> Add New Student
        </a>
    </div>

    <!-- Search & Filter Card -->
    <div class="card mb-4 shadow-sm border-0 bg-light">
        <div class="card-body">
            <form method="get" asp-action="GetAll" class="row g-3 align-items-end">
                <!-- Search by name -->
                <div class="col-md-5">
                    <label class="form-label fw-bold">Search by Student Name</label>
                    <input type="text" name="searchString" value="@Model.SearchString" class="form-control" placeholder="Enter student name..." />
                </div>

                <!-- Filter by Department -->
                <div class="col-md-4">
                    <label class="form-label fw-bold">Filter by Department</label>
                    <select name="departmentId" asp-items="Model.DepartmentList" class="form-select">
                        <option value="">-- All Departments --</option>
                    </select>
                </div>

                <!-- Action Buttons -->
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        Search & Filter
                    </button>
                    <a asp-action="GetAll" class="btn btn-outline-secondary">
                        Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Students Table -->
    @if (Model.Students == null || !Model.Students.Any())
    {
        <div class="alert alert-info" role="alert">
            No students found matching the criteria.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" style="width: 80px;"># ID</th>
                        <th scope="col">Name</th>
                        <th scope="col" style="width: 90px;">Age</th>
                        <th scope="col">Department</th>
                        <th scope="col" class="text-center" style="width: 260px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model.Students)
                    {
                        <tr>
                            <td>@student.Id</td>
                            <td><strong>@student.Name</strong></td>
                            <td>@student.Age</td>
                            <td>@(student.Department?.Name ?? "No Department")</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="GetById" asp-route-id="@student.Id" class="btn btn-info text-white">
                                        Details
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-warning text-dark">
                                        Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-danger">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-muted">
                Showing page <strong>@Model.CurrentPage</strong> of <strong>@Model.TotalPages</strong> (Total: @Model.TotalCount students)
            </span>

            <nav aria-label="Students pagination">
                <ul class="pagination mb-0">
                    <!-- Previous button -->
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="GetAll"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-searchString="@Model.SearchString"
                           asp-route-departmentId="@Model.DepartmentId">
                            &laquo; Previous
                        </a>
                    </li>

                    <!-- Page Numbers -->
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="GetAll"
                               asp-route-page="@i"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-departmentId="@Model.DepartmentId">
                                @i
                            </a>
                        </li>
                    }

                    <!-- Next button -->
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="GetAll"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-searchString="@Model.SearchString"
                           asp-route-departmentId="@Model.DepartmentId">
                            Next &raquo;
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
