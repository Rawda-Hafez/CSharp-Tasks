@model IEnumerable<Department>

@{
    ViewData["Title"] = "All Departments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Departments List</h2>
        <a asp-action="Add" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Department
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            No departments found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col"># ID</th>
                        <th scope="col">Department Name</th>
                        <th scope="col">Manager</th>
                        <th scope="col">Students Count</th>
                        <th scope="col">State</th>
                        <th scope="col" class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dept in Model)
                    {
                        var isMain = dept.Students.Count > 50;
                        <tr>
                            <td>@dept.Id</td>
                            <td><strong>@dept.Name</strong></td>
                            <td>@(string.IsNullOrEmpty(dept.MgrName) ? "N/A" : dept.MgrName)</td>
                            <td>@dept.Students.Count</td>
                            <td>
                                @if (isMain)
                                {
                                    <span class="badge bg-success">Main (&gt; 50)</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Branch (&lt; 50)</span>
                                }
                            </td>
                            <td class="text-center">
                                <a href="/Department/ShowDetails?id=@dept.Id" class="btn btn-info btn-sm text-white">
                                    Details (ViewModel)
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
